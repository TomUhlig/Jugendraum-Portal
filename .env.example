# ============================================================
# Jugendraum-Portal: Umgebungsvariablen
# Lokal: Datei als .env.local kopieren. Beim Hosting (Vercel): unter Settings → Environment Variables eintragen.
# ============================================================

# Postgres-Verbindung (Supabase: Connect → Session pooler → URI). Passwort einsetzen!
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jugendraum

# Öffentliche Adresse der Seite, ohne Schrägstrich am Ende (für Links in E-Mails)
APP_URL=http://localhost:3000

# Zufällige lange Werte (mind. 32 Zeichen), z. B. von https://www.uuidgenerator.net zwei UUIDs hintereinander
SESSION_SECRET=bitte-ersetzen
CRON_SECRET=bitte-ersetzen

# Deine E-Mail-Adresse: wird beim ersten Login automatisch Admin (nur solange noch niemand im Team ist)
INITIAL_ADMIN_EMAIL=

# ---------- Mailversand: EINE der beiden Varianten ----------
# Variante A: normales Postfach per SMTP (keine eigene Domain nötig)
#   Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_PASS=App-Passwort (Google-Konto → Sicherheit → App-Passwörter)
#   GMX:    SMTP_HOST=mail.gmx.net    SMTP_PORT=587  (in GMX: Einstellungen → POP3/IMAP aktivieren)
#   web.de: SMTP_HOST=smtp.web.de     SMTP_PORT=587  (in web.de: Einstellungen → POP3/IMAP aktivieren)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Variante B: Resend (https://resend.com), nur mit eigener, bestätigter Domain
RESEND_API_KEY=

# Optional: Absender und Antwortadresse. Bei SMTP muss der Absender zum Postfach passen.
MAIL_FROM=
MAIL_REPLY_TO=
