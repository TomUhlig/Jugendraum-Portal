# Postgres-Verbindung (Supabase: Project Settings → Database → Connection string, "Session pooler")
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jugendraum

# Öffentliche Adresse der Seite (für Links in E-Mails)
APP_URL=http://localhost:3000

# Zufälliger langer Wert für Admin-Sitzungen:  openssl rand -hex 32
SESSION_SECRET=bitte-ersetzen

# E-Mail-Versand über Resend (https://resend.com). Ohne Key werden Mails nur in der Konsole ausgegeben.
RESEND_API_KEY=
MAIL_FROM="Jugendraum SV Heepen <jugendraum@sv-heepen.de>"
# Optional: Antworten auf automatische Mails landen hier (z. B. Postfach des Orga-Teams)
MAIL_REPLY_TO=

# Schützt die Cron-Endpunkte (Vercel setzt den Header automatisch, wenn CRON_SECRET gesetzt ist)
CRON_SECRET=bitte-ersetzen
